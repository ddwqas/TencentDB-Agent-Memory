# MemoryCore 与 MemoryKnowledge 使用的 LLM
MEMORY_LLM_BASE_URL=https://api.example.com/v1
MEMORY_LLM_API_KEY=REPLACE_ME
MEMORY_LLM_MODEL=REPLACE_ME
# MEMORY_LLM_PROTOCOL accepts openai or responses.
MEMORY_LLM_PROTOCOL=openai


# 示例：Responses 兼容端点
# MEMORY_LLM_MODEL=gpt-5.6-sol
# MEMORY_LLM_PROTOCOL=responses

# MemoryProxy 转发到的上游 LLM
PROXY_UPSTREAM_URL=https://api.example.com/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME
PROXY_UPSTREAM_MODEL=REPLACE_ME

# 本地监听端口
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

