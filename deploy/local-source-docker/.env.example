# 本地源码 Docker 整体镜像配置。
# build.ps1 会从当前工作树直接构建 MEMORY_STACK_IMAGE，
# start-all.ps1 只启动这个整体镜像。

MEMORY_STACK_IMAGE=tdai-local/memory-stack:local

MEMORY_LLM_BASE_URL=REPLACE_ME
MEMORY_LLM_API_KEY=REPLACE_ME
MEMORY_LLM_MODEL=REPLACE_ME
MEMORY_LLM_PROTOCOL=openai

PROXY_UPSTREAM_URL=REPLACE_ME
PROXY_UPSTREAM_API_KEY=REPLACE_ME
PROXY_UPSTREAM_MODEL=REPLACE_ME

MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096

KNOWLEDGE_PUBLIC_BASE_URL=http://host.docker.internal:8424/v3

MEMORY_CORE_VOLUME=tdai-local-memory-core-data
PANEL_VOLUME=tdai-local-panel-data
PROXY_VOLUME=tdai-local-proxy-data

# 生成的配置和 admin key 放在本目录，不与 global-images 混用。
MEMORY_CORE_CONFIG_DIR=./.memory-core-config
PROXY_CONFIG_DIR=./.proxy-config
MEMORY_CORE_ADMIN_KEY_FILE=./.admin-key

# 本地运行默认开启完整 proxy 链路。
PROXY_FULL_STACK=1
MEMORY_CORE_GATEWAY_API_KEY=
